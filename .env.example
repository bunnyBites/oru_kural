SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY        # publishable key — frontend and reads only
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY  # secret key — Python scripts (writes) only; never in frontend

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash

# twscrape — free X scraper using real accounts (replaces X API v2, saves ~$100/mo)
# JSON array of throwaway X account credentials. Use 2–3 accounts for reliability.
# Format: [{"username":"handle","password":"...","email":"...","email_password":"..."}]
TWSCRAPE_ACCOUNTS=[{"username":"handle1","password":"pass1","email":"email1@example.com","email_password":"emailpass1"}]
TWSCRAPE_LIMIT=100   # max tweets to fetch per run (100 is enough for weekly)

# Reddit API (pending approval — use scrape_reddit.py JSON fallback until then)
# REDDIT_CLIENT_ID=        # Reddit app client ID — reddit.com/prefs/apps
# REDDIT_CLIENT_SECRET=    # Reddit app client secret
# REDDIT_USER_AGENT=       # e.g. "oru-kural/1.0 by u/yourusername"

PORT=3000
