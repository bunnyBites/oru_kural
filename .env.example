# ─────────────────────────────────────────────────────────────────────────────
# Oru Kural — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=             # Publishable key — used by backend (reads) and Python reads
SUPABASE_SERVICE_ROLE_KEY=     # Secret key — Python scripts (writes) only; NEVER put in backend or frontend

# ── Gemini AI ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                # Google AI Studio → aistudio.google.com → API keys
GEMINI_MODEL=gemini-2.5-flash  # Default model; change to try other Gemini variants

# ── OpenRouter (optional — overrides Gemini if set) ───────────────────────────
# OPENROUTER_API_KEY=          # openrouter.ai → API keys; presence switches LLM provider
# OPENROUTER_MODEL=google/gemini-2.5-flash  # Model to use via OpenRouter

# ── X API v2 ──────────────────────────────────────────────────────────────────
# Setup: console.x.com → create app → Keys and tokens → Bearer Token
# Cost: ~$0.005/post returned; ~$0.65–2/month at twice-weekly cadence
X_BEARER_TOKEN=                # Bearer Token from console.x.com
X_MAX_RESULTS=50               # Results per API call (10–100); server-side min_faves:50 keeps cost low

# ── Backend server ────────────────────────────────────────────────────────────
PORT=3000                      # Local dev port; Fly.io uses 8080 (set via fly.toml)
FRONTEND_ORIGIN=               # CORS allowed origin, e.g. https://oru-kural.vercel.app
                               # Leave unset for permissive CORS in local dev
RUST_LOG=info                  # Backend log level: error | warn | info | debug

# ── Frontend (compile-time) ───────────────────────────────────────────────────
# Baked into the WASM binary at build time by build_web.sh
# API_BASE_URL=https://oru-kural-backend.fly.dev   # Set this when running build_web.sh

# ── GitHub Actions failure alerts ────────────────────────────────────────────
# These go in GitHub → Settings → Secrets and variables → Actions (not in .env)
# ALERT_EMAIL_USER=            # Gmail address that sends failure alert emails
# ALERT_EMAIL_PASSWORD=        # Gmail App Password (not your login password)
#                              # Generate at myaccount.google.com → Security → App Passwords
# ALERT_EMAIL_TO=              # Recipient address for pipeline failure alerts
